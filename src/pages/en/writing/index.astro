---
import Base from '../../../layouts/Base.astro';
import PostLog from '../../../components/PostLog.astro';
import { getAllPosts, charCount, postLang } from '../../../lib/posts';

const posts = await getAllPosts();
const total = posts.reduce((n, p) => n + charCount(p.body ?? ''), 0);
const english = posts.filter((p) => postLang(p) === 'en').length;
---

<Base lang="en" title="Writing" description="ChiChieh Huang’s essays on generative AI, LLMs, AI agents and agent memory, written in Traditional Chinese, with titles translated into English.">
  <main class="wrap">
    <section class="s first">
      <div class="sh">
        <div class="lab">Field log · Writing</div>
        <h1>{posts.length} essays, <b>{total.toLocaleString('en-US')}</b> characters</h1>
        <p>I write about generative AI in Traditional Chinese, so the titles below are translated. The essays open in Chinese, and your browser can translate them for you. {english > 0 && <>A few early tutorials are in English and marked EN.</>}</p>
      </div>
      <PostLog posts={posts} readQuery lang="en" />
    </section>
  </main>
</Base>

<style>
  .first { padding-top: clamp(40px, 6vw, 80px); }
</style>

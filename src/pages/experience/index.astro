---
import Base from '../../layouts/Base.astro';
import TalkProfile from '../../components/TalkProfile.astro';
import { achievements, talks, media } from '../../data/experience';
import { getAllPosts, postUrl } from '../../lib/posts';

const posts = (await getAllPosts()).filter((p) => !p.data.draft);
const findPost = (id?: string) => (id ? posts.find((p) => p.id === id) : undefined);

// 每日排程會重建網站，「即將登場」會隨建置日期自動輪替到「已完成」
const today = new Date().toISOString().slice(0, 10);
const year = +today.slice(0, 4);
const upcoming = talks.filter((t) => t.date > today).sort((a, b) => a.date.localeCompare(b.date));
const past = talks.filter((t) => t.date <= today).sort((a, b) => b.date.localeCompare(a.date));
const total = talks.reduce((n, t) => n + (t.count ?? 1), 0);
const done = past.reduce((n, t) => n + (t.count ?? 1), 0);
const dd = (d: string) => d.replaceAll('-', '.');
---

<Base title="演講與經歷" description="黃琪婕的演講、獎項與媒體報導。">
  <main class="wrap">
    <section class="s first">
      <div class="sh">
        <div class="lab">足跡 · 演講、紀錄與報導</div>
        <h1>{year} 年，<b>{total}</b> 場演講與工作坊</h1>
        <p>講過的、得過的、被報導過的。有寫心得的都附上文章。已完成 {done} 場，還有 {total - done} 場即將登場。</p>
      </div>
      <TalkProfile talks={talks} year={year} today={today} />
    </section>

    {upcoming.length > 0 && (
      <section class="s">
        <div class="sh"><div class="lab">即將登場</div><h2>下一站</h2></div>
        <div class="next">
          {upcoming.map((t) => (
            <div class="nx">
              <span class="date">{dd(t.date).slice(5)}</span>
              <div><span class="lab">{dd(t.date)}</span><h3>{t.event}</h3>{t.topic && <p>{t.topic}</p>}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="s">
      <div class="sh"><div class="lab">演講與工作坊 · {done} 場</div><h2>走過的講台</h2></div>
      <div class="rows">
        {past.map((t) => {
          const post = findPost(t.postId);
          const photo = t.photo ?? (t.major ? post?.data.hero : undefined);
          return (
            <article class:list={['row', { major: t.major }]}>
              <span class="d">{dd(t.date)}{(t.count ?? 1) > 1 && <em>×{t.count}</em>}</span>
              <div class="main">
                <h3>{t.event}</h3>
                {t.topic && <p class="topic">{t.topic}</p>}
                {t.detail && <p class="det">{t.detail}</p>}
                {post && <a class="go" href={postUrl(post)}>現場心得 →</a>}
              </div>
              {photo ? <img class="ph" src={photo} alt={`${t.event} 現場`} loading="lazy" /> : <span />}
            </article>
          );
        })}
      </div>
    </section>

    <section class="s">
      <div class="sh"><div class="lab">紀錄</div><h2>比賽與里程碑</h2></div>
      <div class="rows">
        {achievements.map((a) => {
          const post = findPost(a.postId);
          return (
            <article class="row">
              <span class="d">{a.year ?? '—'}</span>
              <div class="main"><h3>{a.title}</h3><p class="det">{a.detail}</p>{post && <a class="go" href={postUrl(post)}>閱讀心得 →</a>}</div>
              <span />
            </article>
          );
        })}
      </div>
    </section>

    <section class="s">
      <div class="sh"><div class="lab">報導</div><h2>媒體採訪</h2></div>
      <div class="rows">
        {media.map((m) => {
          const post = findPost(m.postId);
          const photo = m.photo ?? post?.data.hero;
          return (
            <article class="row">
              <span class="d">{m.year ?? ''}</span>
              <div class="main"><h3>{m.outlet}</h3><p class="det">{m.detail}</p>{post && <a class="go" href={postUrl(post)}>受訪心得 →</a>}</div>
              {photo ? <img class="ph" src={photo} alt={`${m.outlet} 報導畫面`} loading="lazy" /> : <span />}
            </article>
          );
        })}
      </div>
    </section>
  </main>
</Base>

<style>
  .first { padding-top: clamp(40px, 6vw, 80px); }
  .next { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--ink-2); }
  .nx { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 24px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .nx .date { font-family: var(--mono); font-stretch: 80%; font-weight: 300; font-size: clamp(40px, 5vw, 64px); line-height: 1; color: var(--trail); }
  .nx h3 { margin: 4px 0 0; font-weight: 500; font-size: 19px; }
  .nx p { margin: 2px 0 0; color: var(--ink-2); font-size: 14px; }
  .rows { border-top: 1px solid var(--ink-2); }
  .row { display: grid; grid-template-columns: 110px minmax(0, 1fr) 176px; gap: 24px; align-items: start; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .d { font-family: var(--mono); font-stretch: 80%; font-size: 12px; color: var(--ink-2); letter-spacing: .04em; padding-top: 4px; }
  .d em { font-style: normal; color: var(--trail); margin-left: 8px; }
  .main h3 { margin: 0; font-weight: 500; font-size: 18px; line-height: 1.5; }
  .row.major h3 { color: var(--trail); }
  .topic { margin: 4px 0 0; font-size: 15.5px; color: var(--ink); }
  .det { margin: 4px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.75; max-width: 46em; }
  .go { display: inline-block; margin-top: 8px; font-family: var(--mono); font-stretch: 80%; font-size: 11px; letter-spacing: .14em; color: var(--trail); }
  .ph { width: 176px; height: 112px; object-fit: cover; border: 1px solid var(--line); filter: grayscale(.6); transition: filter .2s; }
  .row:hover .ph { filter: none; }
  @media (max-width: 760px) {
    .next { grid-template-columns: 1fr; }
    .row { grid-template-columns: minmax(0, 1fr) 96px; gap: 6px 16px; }
    .d { grid-column: 1 / -1; padding: 0; }
    .ph { width: 96px; height: 64px; }
  }
</style>

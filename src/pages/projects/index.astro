---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import { getAllPosts, postUrl } from '../../lib/posts';

const hackathon = (await getAllPosts()).find((p) => p.id === 'antropic-hackathon');
const [lead, ...rest] = projects;
---

<Base title="作品" description="黃琪婕的開源專案與作品：Cairn、LLMAvatarTalk、GraphRAG 視覺化教學等。">
  <main class="wrap">
    <section class="s first">
      <div class="sh">
        <div class="lab">營地 · 作品</div>
        <h1>做出來的東西</h1>
        <p>做過的、正在做的。開源的都附上 repo，大多也有一篇教學文章。</p>
      </div>
      <div class="lead">
        <div class="cl">
          <span class="lab">基地營 · {lead.status ?? ''}</span>
          <h2>{lead.name}</h2>
          <p class="quote">石堆（cairn）是登山客留給後來的人的路標。這個網站的地圖用的就是 Cairn 的想法：每個人留下的經驗，會變成別人找得到的路。</p>
          <p>{lead.summary}</p>
          <p class="stack lab">{lead.stack.join(' · ')}</p>
          <div class="acts">
            {lead.link && <a class="btn" href={lead.link}>看 Demo 影片 →</a>}
            {hackathon && <a class="btn" href={postUrl(hackathon)}>Hackathon 開發心得 →</a>}
          </div>
        </div>
        {hackathon?.data.hero && <div class="art"><img src={hackathon.data.hero} alt="Anthropic Hackathon 主視覺" /></div>}
      </div>
      <div class="grid">
        {rest.map((p) => (
          <article class="camp">
            <span class="lab"><span>{p.stack.slice(0, 3).join(' · ')}</span>{p.status && <span>{p.status}</span>}</span>
            <h2>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</h2>
            <p>{p.summary}</p>
            {p.link && <a class="go" href={p.link}>{p.link.includes('github.com') ? 'GitHub →' : '看看 →'}</a>}
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .first { padding-top: clamp(40px, 6vw, 80px); }
  .lead { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding-bottom: clamp(40px, 5vw, 64px); margin-bottom: clamp(32px, 4vw, 48px); border-bottom: 1px solid var(--line); }
  .cl { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .cl h2 { margin: 0; font-weight: 200; font-size: clamp(56px, 8vw, 120px); line-height: 1; letter-spacing: .02em; }
  .cl p { margin: 0; font-size: 17px; }
  .quote { font-size: clamp(18px, 1.6vw, 22px) !important; font-weight: 300; border-left: 2px solid var(--trail); padding-left: 18px; line-height: 1.7; }
  .stack { color: var(--ink-3) !important; font-size: 11px !important; }
  .acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .art { aspect-ratio: 1; border: 1px solid var(--line); background: var(--ground-2); overflow: hidden; }
  .art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 36px) clamp(16px, 2vw, 28px); }
  .camp { border-top: 1px solid var(--ink-2); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .camp .lab { display: flex; justify-content: space-between; gap: 8px; }
  .camp h2 { margin: 0; font-weight: 500; font-size: 22px; line-height: 1.4; }
  .camp h2 a:hover { color: var(--trail); }
  .camp p { margin: 0; font-size: 15px; font-weight: 300; color: var(--ink-2); line-height: 1.8; }
  .go { margin-top: auto; padding-top: 6px; font-family: var(--mono); font-stretch: 80%; font-size: 11px; letter-spacing: .14em; color: var(--trail); }
  @media (max-width: 900px) { .lead { grid-template-columns: 1fr; } .grid { grid-template-columns: 1fr; } }
</style>

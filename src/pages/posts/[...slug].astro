---
import PostView from '../../views/Post.astro';
import { getAllPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer: Post | null; older: Post | null };
---

<PostView post={post} lang="zh" newer={newer} older={older} />

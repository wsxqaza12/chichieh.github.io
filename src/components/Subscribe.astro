---
// 電子報訂閱框：文章結尾（band）與 /newsletter/ 頁（page）共用。
// 有 JS 時用 fetch 送出、原地顯示結果；沒有 JS 時一般表單送出，Worker 會導回 /newsletter/?s=…
// 後端：newsletter/（Cloudflare Worker，chichieh-huang.com/api/newsletter/*）
import type { Lang } from '../i18n';

interface Props { lang?: Lang; variant?: 'band' | 'page' }
const { lang = 'zh', variant = 'band' } = Astro.props;
const en = lang === 'en';
const T = en
  ? {
      lab: 'Newsletter',
      title: ['Get the next essay ', 'by email.'],
      text: 'One email when a new essay goes up, nothing else. Unsubscribe in one click.',
      placeholder: 'you@example.com',
      label: 'Your email',
      send: 'Subscribe',
    }
  : {
      lab: '電子報',
      title: ['下一篇寫好時，', '寄給你。'],
      text: '新文章上站時寄一封信，不寄別的。隨時一鍵退訂。',
      placeholder: 'you@example.com',
      label: '你的 Email',
      send: '訂閱',
    };
const msgs = en
  ? {
      sending: 'Sending…',
      check: 'Almost there: check your inbox and click the link to confirm. (Not there? Look in spam.)',
      invalid: "That address doesn't look like it can receive mail. Typo?",
      slow: 'Too many tries. Please wait a bit and try again.',
      error: 'Something went wrong. Please try again in a moment.',
    }
  : {
      sending: '送出中…',
      check: '差一步：到信箱點確認連結就完成了。（沒看到的話，看一下垃圾信匣。）',
      invalid: '這個 Email 看起來收不到信，檢查一下有沒有打錯？',
      slow: '嘗試太多次了，等一下再試。',
      error: '出了點問題，請稍後再試。',
    };
---

<section class:list={['sub', variant]} data-sub data-msgs={JSON.stringify(msgs)}>
  {variant === 'band' && (
    <div class="copy">
      <span class="lab">{T.lab}</span>
      <h2 class="keep">{T.title[0]}<b>{T.title[1]}</b></h2>
      <p>{T.text}</p>
    </div>
  )}
  <form method="post" action="/api/newsletter/subscribe" novalidate>
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="source" value={Astro.url.pathname} />
    <label class="hp" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    <div class="row">
      <label class="vh" for={`sub-${variant}`}>{T.label}</label>
      <input id={`sub-${variant}`} type="email" name="email" required autocomplete="email" inputmode="email" placeholder={T.placeholder} spellcheck="false" />
      <button class="btn go" type="submit">{T.send}<span aria-hidden="true">→</span></button>
    </div>
    <p class="msg" role="status" aria-live="polite"></p>
  </form>
</section>

<style>
  .sub.band {
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 20px clamp(24px, 4vw, 64px); align-items: end;
    padding-block: clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--line);
  }
  .copy h2 { margin: 6px 0 10px; font-weight: 300; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.3; }
  .copy h2 b { font-weight: 500; color: var(--trail); }
  .copy p { margin: 0; color: var(--ink-2); font-size: 15px; max-width: 34em; word-break: keep-all; overflow-wrap: anywhere; }
  form { min-width: 0; }
  .row { display: flex; border: 1px solid var(--ink-3); transition: border-color .15s; }
  .row:focus-within { border-color: var(--trail); }
  input[type='email'] {
    flex: 1; min-width: 0; background: transparent; border: 0; color: var(--ink); font: inherit; font-size: 16px;
    padding: 13px 14px; outline: none;
  }
  input[type='email']::placeholder { color: var(--ink-3); }
  .go { border: 0; border-left: 1px solid var(--ink-3); padding-inline: 18px; color: var(--ink); }
  .row:focus-within .go { border-left-color: var(--trail); }
  .go:hover, .go:focus-visible { background: var(--trail); color: var(--ground); outline: none; }
  .msg { margin: 10px 0 0; min-height: 1.6em; font-size: 14px; color: var(--ink-2); }
  .msg[data-state='check'] { color: var(--trail); }
  .msg[data-state='invalid'], .msg[data-state='slow'], .msg[data-state='error'] { color: var(--ink); }
  [data-sub][data-busy] .go { opacity: .5; pointer-events: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 760px) { .sub.band { grid-template-columns: 1fr; } }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-sub]')) {
    const form = box.querySelector('form')!;
    const msg = box.querySelector<HTMLElement>('.msg')!;
    const msgs = JSON.parse(box.dataset.msgs!);
    const show = (state: string) => { msg.dataset.state = state; msg.textContent = msgs[state] ?? msgs.error; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (!/^\S+@\S+\.\S+$/.test(String(data.email ?? '').trim())) return show('invalid');
      box.dataset.busy = '';
      show('sending');
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        const body = await res.json().catch(() => ({}));
        show(body.state ?? (res.ok ? 'check' : 'error'));
        if (body.state === 'check') form.reset();
      } catch {
        show('error');
      } finally {
        delete box.dataset.busy;
      }
    });
  }
</script>

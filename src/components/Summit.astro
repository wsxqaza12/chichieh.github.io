---
// 頭像放在山頂：外圍是手繪感的等高線
interface Props { size?: string }
const { size = '100%' } = Astro.props;
let rings = '';
for (let i = 0; i < 9; i++) {
  const R = 96 + i * 12.5;
  let d = '';
  for (let a = 0; a <= 64; a++) {
    const th = (a / 64) * Math.PI * 2;
    const wob = 1 + 0.035 * Math.sin(th * 3 + i) + 0.02 * Math.sin(th * 5 - i * 1.7);
    d += (a ? 'L' : 'M') + (200 + Math.cos(th) * R * wob).toFixed(1) + ' ' + (200 + Math.sin(th) * R * wob).toFixed(1);
  }
  const major = i % 4 === 3;
  rings += `<path d="${d}Z" fill="none" stroke="var(${major ? '--contour-major' : '--contour'})" stroke-width="${major ? 1.3 : 0.8}"/>`;
}
---

<div class="summit" style={`max-width:${size}`}>
  <svg viewBox="0 0 400 400" aria-hidden="true" set:html={rings} />
  <img src="/assets/img/avatar-640.webp" alt="黃琪婕" width="640" height="640" loading="lazy" />
  <span class="lab tag">▲ 測繪者</span>
</div>

<style>
  .summit { position: relative; aspect-ratio: 1; width: 100%; display: grid; place-items: center; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  img { width: 46%; height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; position: relative; filter: grayscale(.2); }
  .tag { position: absolute; top: 2%; left: 50%; transform: translateX(-50%); color: var(--ink-3); }
</style>

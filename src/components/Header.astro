---
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;

const nav = [
  { href: '/', label: '地圖', short: true },
  { href: '/posts/', label: '文章', short: true },
  { href: '/experience/', label: '演講', short: false },
  { href: '/projects/', label: '作品', short: false },
  { href: '/about/', label: '關於', short: true },
];
const path = Astro.url.pathname;
const isOn = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['top', { overlay }]}>
  <div class:list={['bar', { wrap: !overlay }]}>
    <a class="id" href="/" aria-label="黃琪婕 首頁">
      <span class="pin" aria-hidden="true"></span>
      <span><b>黃琪婕</b><span class="sub">CHICHIEH HUANG · GEN AI</span></span>
    </a>
    <nav aria-label="主選單">
      {nav.map((item) => (
        <a href={item.href} class:list={{ on: isOn(item.href), long: !item.short }} aria-current={isOn(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <button class="tgl" id="theme-toggle" type="button" aria-label="切換日間與夜間">日間</button>
    </nav>
  </div>
</header>

<style>
  .top { position: relative; z-index: 20; }
  .top.overlay { position: absolute; left: 0; right: 0; top: 0; padding-inline: var(--gut); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px; }
  .top:not(.overlay) .bar { border-bottom: 1px solid var(--line); }
  .id { display: flex; align-items: center; gap: 12px; }
  .pin { width: 26px; height: 26px; border: 1.5px solid var(--trail); border-radius: 50%; display: grid; place-items: center; flex: none; }
  .pin::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--trail); }
  .id b { font-weight: 500; font-size: 16px; letter-spacing: .12em; display: block; line-height: 1.3; }
  .sub { display: block; font-family: var(--mono); font-stretch: 80%; font-size: 10.5px; letter-spacing: .16em; color: var(--ink-2); line-height: 1.3; }
  .overlay .id b, .overlay .sub { text-shadow: 0 0 8px var(--halo), 0 0 2px var(--halo); }
  nav { display: flex; gap: clamp(12px, 2.2vw, 28px); align-items: center; }
  nav a { font-family: var(--mono); font-stretch: 80%; font-size: 11.5px; letter-spacing: .16em; color: var(--ink-2); white-space: nowrap; }
  .overlay nav a { text-shadow: 0 0 8px var(--halo), 0 0 2px var(--halo); }
  nav a:hover, nav a.on { color: var(--trail); }
  .tgl { font-family: var(--mono); font-stretch: 80%; font-size: 11px; letter-spacing: .14em; background: var(--ground); border: 1px solid var(--line); color: var(--ink); padding: 7px 11px; cursor: pointer; white-space: nowrap; }
  .tgl:hover { border-color: var(--trail); color: var(--trail); }
  @media (max-width: 760px) { nav a.long { display: none; } }
  @media (max-width: 520px) { .sub { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const isLight = () => (root.dataset.theme ? root.dataset.theme === 'light' : matchMedia('(prefers-color-scheme: light)').matches);
  const sync = () => { btn.textContent = isLight() ? '夜間' : '日間'; };
  sync();
  btn.addEventListener('click', () => {
    root.dataset.theme = isLight() ? 'dark' : 'light';
    try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    sync();
    window.dispatchEvent(new Event('themechange'));
  });
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    sync();
    window.dispatchEvent(new Event('themechange'));
  });
</script>

---
import { nav, ui, altPath, type Lang } from '../i18n';

interface Props { overlay?: boolean; lang?: Lang }
const { overlay = false, lang = 'zh' } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const home = lang === 'en' ? '/en/' : '/';
const isOn = (href: string) => {
  if (href === home) return path === home;
  if (href === '/speaking/') return path.startsWith('/speaking/') || path.startsWith('/experience/');
  return path.startsWith(href);
};
const invite = lang === 'en' ? '/en/speaking/#book' : '/speaking/#book';
---

<header class:list={['top', { overlay }]}>
  <div class:list={['bar', { wrap: !overlay }]}>
    <a class="id" href={home} aria-label={t.homeLabel}>
      <span class="pin" aria-hidden="true"></span>
      <span>{lang === 'en' ? <b class="en">ChiChieh Huang</b> : <b>黃琪婕</b>}<span class="sub">{t.sub}</span></span>
    </a>
    <button class="menu" id="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">{lang === 'en' ? 'Menu' : '選單'}</button>
    <nav id="main-nav" aria-label={lang === 'en' ? 'Main' : '主選單'}>
      {nav[lang].map((item) => (
        <a href={item.href} class:list={{ on: isOn(item.href), long: !item.short }} aria-current={isOn(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="invite" href={invite}>{t.invite}</a>
      <a class="lang" href={altPath(path)} hreflang={lang === 'en' ? 'zh-Hant' : 'en'} lang={lang === 'en' ? 'zh-Hant' : 'en'} aria-label={t.otherLangLabel}>{t.otherLang}</a>
      <button class="tgl" id="theme-toggle" type="button" aria-label={t.themeLabel} data-day={t.day} data-night={t.night}>{t.day}</button>
    </nav>
  </div>
</header>

<style>
  .top { position: relative; z-index: 20; }
  .top.overlay { position: absolute; left: 0; right: 0; top: 0; padding-inline: var(--gut); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px; }
  .top:not(.overlay) .bar { border-bottom: 1px solid var(--line); }
  .id { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .pin { width: 26px; height: 26px; border: 1.5px solid var(--trail); border-radius: 50%; display: grid; place-items: center; flex: none; }
  .pin::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--trail); }
  .id b { font-weight: 500; font-size: 16px; letter-spacing: .12em; display: block; line-height: 1.3; white-space: nowrap; }
  .id b.en { letter-spacing: .04em; }
  .sub { display: block; font-family: var(--mono); font-stretch: 80%; font-size: 10.5px; letter-spacing: .16em; color: var(--ink-2); line-height: 1.3; white-space: nowrap; }
  .overlay .id b, .overlay .sub { text-shadow: 0 0 8px var(--halo), 0 0 2px var(--halo); }
  nav { display: flex; gap: clamp(10px, 2vw, 26px); align-items: center; }
  nav a { font-family: var(--mono); font-stretch: 80%; font-size: 11.5px; letter-spacing: .16em; color: var(--ink-2); white-space: nowrap; }
  .overlay nav a { text-shadow: 0 0 8px var(--halo), 0 0 2px var(--halo); }
  nav a:hover, nav a.on { color: var(--trail); }
  nav a.invite { color: var(--trail); border: 1px solid var(--trail); padding: 7px 11px; text-shadow: none; background: color-mix(in srgb, var(--ground) 70%, transparent); }
  nav a.invite:hover { background: var(--trail); color: var(--ground); }
  nav a.lang { border: 1px solid var(--line); padding: 7px 9px; color: var(--ink); text-shadow: none; background: var(--ground); }
  nav a.lang:hover { border-color: var(--trail); color: var(--trail); }
  .tgl { font-family: var(--mono); font-stretch: 80%; font-size: 11px; letter-spacing: .14em; background: var(--ground); border: 1px solid var(--line); color: var(--ink); padding: 7px 11px; cursor: pointer; white-space: nowrap; }
  .tgl:hover { border-color: var(--trail); color: var(--trail); }
  .menu { display: none; font-family: var(--mono); font-stretch: 80%; font-size: 11px; letter-spacing: .14em; background: var(--ground); border: 1px solid var(--line); color: var(--ink); padding: 8px 12px; cursor: pointer; }
  .menu[aria-expanded='true'] { border-color: var(--trail); color: var(--trail); }
  @media (max-width: 980px) and (min-width: 641px) { nav a.long { display: none; } }
  /* 手機：選單收成一顆按鈕，展開後是整片清單 */
  @media (max-width: 640px) {
    .sub { display: none; }
    .bar { position: relative; }
    .menu { display: block; }
    nav { display: none; position: absolute; left: calc(var(--gut) * -1); right: calc(var(--gut) * -1); top: 100%; z-index: 30; flex-direction: column; align-items: stretch; gap: 0; padding: 6px var(--gut) 18px; background: var(--ground); border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px -24px rgba(0, 0, 0, .5); }
    .top:not(.overlay) nav { left: 0; right: 0; }
    nav.open { display: flex; }
    nav a, nav a.long { display: block; padding: 14px 0; font-size: 13px; border-bottom: 1px solid var(--line); text-shadow: none; }
    nav a.invite, nav a.lang { border: 0; border-bottom: 1px solid var(--line); padding: 14px 0; background: none; }
    nav a.invite { color: var(--trail); }
    .tgl { align-self: flex-start; margin-top: 14px; }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const isLight = () => (root.dataset.theme ? root.dataset.theme === 'light' : matchMedia('(prefers-color-scheme: light)').matches);
  const sync = () => { btn.textContent = isLight() ? btn.dataset.night! : btn.dataset.day!; };
  sync();
  btn.addEventListener('click', () => {
    root.dataset.theme = isLight() ? 'dark' : 'light';
    try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    sync();
    window.dispatchEvent(new Event('themechange'));
  });
  const menu = document.getElementById('menu-btn')!, navEl = document.getElementById('main-nav')!;
  const setMenu = (open: boolean) => { navEl.classList.toggle('open', open); menu.setAttribute('aria-expanded', String(open)); };
  menu.addEventListener('click', () => setMenu(!navEl.classList.contains('open')));
  navEl.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && navEl.classList.contains('open')) { setMenu(false); menu.focus(); } });
  document.addEventListener('click', (e) => { if (navEl.classList.contains('open') && !(e.target as HTMLElement).closest('header')) setMenu(false); });
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    sync();
    window.dispatchEvent(new Event('themechange'));
  });
</script>

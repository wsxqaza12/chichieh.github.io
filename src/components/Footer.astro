---
import { getSummaries } from '../lib/posts';
const total = (await getSummaries()).reduce((n, p) => n + p.n, 0);
const year = new Date().getFullYear();
---

<footer class="wrap">
  <span class="lab">© {year} 黃琪婕 · 由文字與一隻龍蝦驅動</span>
  <span class="links lab">
    <a href="https://github.com/wsxqaza12">GitHub</a>
    <a href="https://www.linkedin.com/in/chichieh-huang-5322881ba/">LinkedIn</a>
    <a href="/rss.xml">RSS</a>
  </span>
  <span class="lab">N 25°02′ E 121°33′ · 比例尺 1 : {total.toLocaleString('en-US')} 字</span>
</footer>

<style>
  footer { margin-top: clamp(80px, 10vw, 140px); border-top: 1px solid var(--line); padding-block: 24px 48px; display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; }
  .links { display: flex; gap: 18px; }
  .links a:hover { color: var(--trail); }
</style>

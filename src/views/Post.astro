---
// 文章頁（中、英共用）。英文版讀 src/content/en/ 的翻譯，地點、日期、連載跟著中文原文。
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  getAllPosts, getSummaries, postUrl, dotDate, readingTime, lengthOf, displayTitle, titleIn, regionOfPost, englishOf, type Post,
} from '../lib/posts';
import { REGIONS, regionName } from '../lib/regions';
import { seriesOf, resolveSeries } from '../data/series';
import { makeModel, nearest } from '../lib/terrain/model';
import type { Lang } from '../i18n';
import Subscribe from '../components/Subscribe.astro';

interface Props { post: Post; lang: Lang; newer: Post | null; older: Post | null }
const { post, lang, newer, older } = Astro.props;
const en = lang === 'en';
const zhNum = ['一', '二', '三', '四', '五', '六'];
const T = en
  ? {
      writing: 'Writing', season: (n: number) => `Season ${n}`, part: (n: number) => `Part ${n}`, draft: 'Draft',
      date: 'Date', length: 'Length', unit: 'words', read: 'Reading', mins: (m: number) => `~${m} min`,
      cites: 'Sources', citesV: (n: number) => `${n} ${n === 1 ? 'reference' : 'references'}`, figs: 'Figures',
      figV: (n: number) => `${n} ${n === 1 ? 'figure' : 'figures'}`, tabV: (n: number) => `${n} ${n === 1 ? 'table' : 'tables'}`,
      name: 'ChiChieh Huang', role: 'Founder · AI engineer', copy: 'Copy link', copied: 'Link copied',
      locAria: (r: string) => `Locator map: this essay sits in the ${r} on the map of my writing.`, locTitle: 'Locator', around: (r: string) => r,
      scale: '2 wks', overview: 'Overview', route: 'Route', finish: 'Finish', start: 'Start reading',
      endLab: 'End of the trail', rss: 'RSS feed', youAreHere: 'you are here', upcoming: 'In the works',
      prev: '← Previous', next: 'Next', nearLab: 'Nearby cairns · the closest essays on the map', sameDay: 'same day',
      apart: (d: number) => `${d} ${d === 1 ? 'day' : 'days'} apart`, surveyor: 'Surveyor',
      bio: 'I build generative AI products and write about them, first in Chinese. Lately I’ve been researching agent memory and testing the ideas in Cairn.',
      about: 'About me', zoom: 'Enlarged image', close: 'Close ✕',
    }
  : {
      writing: '文章', season: (n: number) => `第${zhNum[n - 1]}季`, part: (n: number) => `第 ${n} 段`, draft: '草稿',
      date: '日期', length: '字數', unit: '字', read: '閱讀', mins: (m: number) => `約 ${m} 分鐘`,
      cites: '引用', citesV: (n: number) => `${n} 份資料`, figs: '圖表', figV: (n: number) => `${n} 圖`, tabV: (n: number) => `${n} 表`,
      name: '黃琪婕', role: 'Generative AI 產品開發 · 技術寫作', copy: '複製連結', copied: '已複製連結',
      locAria: (r: string) => `位置圖：這篇在寫作地形圖的${r}一帶。`, locTitle: '位置圖', around: (r: string) => `${r}一帶`,
      scale: '2 週', overview: '全圖', route: '本篇路線', finish: '終點', start: '開始閱讀',
      endLab: '本段終點', rss: 'RSS 訂閱', youAreHere: '你在這裡', upcoming: '籌備中',
      prev: '← 上一篇', next: '下一篇', nearLab: '附近的石堆 · 地圖上離這篇最近的文章', sameDay: '同一天',
      apart: (d: number) => `相距 ${d} 天`, surveyor: '測繪者',
      bio: '做 Generative AI 產品，也把它寫成中文。最近在研究 Agent Memory，並放回 Cairn 裡實作對照。',
      about: '關於我', zoom: '放大圖片', close: '關閉 ✕',
    };
// 給瀏覽器端腳本的字串
const JS = en
  ? { here: 'This essay', reading: 'Reading', start: T.start, done: 'Finished', left: '~{n} min left' }
  : { here: '本篇', reading: '閱讀中', start: T.start, done: '走完了', left: '剩約 {n} 分鐘' };

const all = await getAllPosts();
const tr = en ? englishOf(post)! : null;
const entry = tr ?? post;
const { Content, headings } = await render(entry);
const body = entry.body ?? '';
const title = titleIn(post, lang);
const description = tr ? tr.data.description ?? title : post.data.description ?? title;
const tags = tr ? tr.data.tags : post.data.tags;
const minutes = readingTime(body);
const size = lengthOf(post, lang);
const region = REGIONS.find((r) => r.key === regionOfPost(post))!;
const rname = regionName(region.key, lang);
const place = seriesOf(post.id);
const home = en ? '/en/' : '/';
const zhUrl = postUrl(post), enUrl = englishOf(post) ? postUrl(post, 'en') : null;

// 圖表與引用數量（從 markdown 直接數）
const figs = (body.match(/!\[[^\]]*\]\([^)]+\)/g) ?? []).length;
const tables = (body.match(/^\s*\|?\s*:?-{3,}:?\s*\|/gm) ?? []).length;
const refSection = body.split(/^##\s*(?:參考資料|參考文獻|資料來源|References)\s*$/m)[1] ?? '';
const refs = (refSection.match(/^\s*(?:[-*]|\d+\.)\s.*\][([]/gm) ?? []).length;

const byId = new Map(all.map((p) => [p.id, p]));
// 英文版地圖只畫有英文版的文章（跟英文首頁同一張圖）
const summaries = (await getSummaries()).filter((s) => !en || s.es);
const model = makeModel(summaries, 'h');
// 連載：依目前上站的文章算出每一季有哪幾篇（英文版只算有翻譯的）
const seasons = place ? resolveSeries(place.series, all.filter((p) => !en || englishOf(p)).map((p) => p.id)) : [];
const epLabel = (id: string) => { const s = seriesOf(id); return s ? `S${s.season.n}·${s.ep}` : ''; };
const exclude = new Set(seasons.flatMap((s) => s.posts));
const near = nearest(model, post.id, 3, exclude);

// 段落：以 h2 為主；舊的 Medium 文章用 h3 分段，h2 不足兩個時改用 h3
const h2s = headings.filter((h) => h.depth === 2);
const sections = h2s.length >= 2 ? h2s : headings.filter((h) => h.depth === 3);
const seriesIds = seasons.flatMap((s) => s.posts.map((id) => ({ id, label: epLabel(id) })));
const pageUrl = new URL(postUrl(post, lang), Astro.site).toString();
const num = (n: number) => n.toLocaleString('en-US');
---

<Base
  lang={lang}
  title={title}
  description={description}
  ogImage={en ? `/og/en/${tr!.id}.jpg` : `/og/${post.id}.jpg`}
  ogType="article"
  alternate={enUrl ? { zh: zhUrl, en: enUrl } : undefined}
>
  <div class="prog" id="prog" aria-hidden="true"></div>
  <main class="wrap">
    <section class="hero">
      <div>
        <div class="crumbs lab">
          <a href={en ? '/en/writing/' : '/posts/'}>{T.writing}</a><i></i>
          {!en && (<><a href={`/posts/category/${post.data.category}/`}>{post.data.category}</a><i></i></>)}
          <a href={en ? `/en/writing/?r=${region.id}` : `/posts/?r=${encodeURIComponent(region.key)}`}>{en ? region.name : `${region.key}${region.suffix} · ${region.en}`}</a>
          {place && (<><i></i><span class="here">{place.series.name} · {T.season(place.season.n)} · {T.part(place.ep)}</span></>)}
          {post.data.draft && <span class="draft">{T.draft}</span>}
        </div>
        <h1 class="keep">{title}</h1>
        <div class="meta">
          <div><span class="lab">{T.date}</span><b>{dotDate(post.data.date)}</b></div>
          <div><span class="lab">{T.length}</span><b>{num(size)}{en && ' words'}</b></div>
          <div><span class="lab">{T.read}</span><b>{T.mins(minutes)}</b></div>
          {refs > 0 && <div><span class="lab">{T.cites}</span><b>{T.citesV(refs)}</b></div>}
          {(figs > 0 || tables > 0) && <div><span class="lab">{T.figs}</span><b>{[figs && T.figV(figs), tables && T.tabV(tables)].filter(Boolean).join(' · ')}</b></div>}
        </div>
        <div class="byrow">
          <img src="/assets/img/avatar-640.webp" alt="" width="40" height="40" />
          <span class="who"><b>{T.name}</b><span class="lab">{T.role}</span></span>
          <button class="btn" type="button" data-copy={pageUrl} data-done={T.copied}>{T.copy}</button>
        </div>
        {en && <p class="tr lab">Translated from the Chinese original · <a href={zhUrl} hreflang="zh-Hant">Read the original</a></p>}
      </div>
      <div class="locator" id="loc" data-id={post.id} data-lang={lang} data-s={JSON.stringify(JS)} data-series={JSON.stringify(seriesIds)}>
        <canvas id="lcv" role="img" aria-label={T.locAria(rname)}></canvas>
        <div class="ttl lab">{T.locTitle}<b>{T.around(rname)}</b></div>
        <div id="lov"></div>
        <div class="mtip" id="mtip"></div>
        <div class="lscale"><i id="lsc" style="width:50px"></i><span>{T.scale}</span></div>
        <div class="inset"><span>{T.overview}</span><canvas id="icv" aria-hidden="true"></canvas></div>
      </div>
    </section>

    <div class="desk">
      <aside class="route" aria-label={T.route}>
        <div class="head"><span class="lab">{T.route}</span><b id="pct">0%</b><span class="lab" id="left" data-mins={minutes}>{T.mins(minutes)}</span></div>
        <div class="path" id="path"><div class="base"></div><div class="fill" id="fill"></div><div class="me" id="me"></div></div>
        <div class="foot lab">{T.finish}{sections.length ? ` · ${sections[sections.length - 1].text.replace(/^\d+[.．、]\s*/, '')}` : ''}</div>
      </aside>
      <div class="mbar" id="mbar">
        <button type="button" id="mbtn" aria-expanded="false"><span id="mcur">{T.start}</span><span class="pct" id="mpct">0%</span></button>
        {sections.length > 0 && (
          <ol id="mlist" hidden>
            {sections.map((h) => (
              <li><a href={`#${h.slug}`}><em>{(h.text.match(/^(\d+)[.．、]/)?.[1] ?? '').padStart(h.text.match(/^\d/) ? 2 : 0, '0')}</em><span>{h.text.replace(/^\d+[.．、]\s*/, '')}</span></a></li>
            ))}
          </ol>
        )}
        <div class="pbar" id="mpbar"></div>
      </div>

      <div class="paper">
        <article class="prose" id="prose">
          <Content />
        </article>

        {tags.length > 0 && (
          <p class="tags lab">{tags.map((t) => <span>#{t}</span>)}</p>
        )}

        <div class="end">
          <div class="fin">
            <svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><g fill="var(--trail)" stroke="var(--ground)" stroke-width="2"><ellipse cx="32" cy="55" rx="24" ry="7"/><ellipse cx="33" cy="42" rx="18" ry="6.2"/><ellipse cx="31" cy="30.5" rx="13" ry="5.2"/><ellipse cx="32.5" cy="21" rx="8.5" ry="4.2"/></g></svg>
            <div><span class="lab">{T.endLab}</span><p class="fint">{en ? <><b>{num(size)}</b> words, and you made it to the end.</> : <>這段路 <b>{num(size)}</b> 字，走完了。</>}</p></div>
            <div class="acts">
              <button class="btn" type="button" data-copy={pageUrl} data-done={T.copied}>{T.copy}</button>
              <a class="btn" href={en ? '/en/rss.xml' : '/rss.xml'}>{T.rss}</a>
              <a class="btn" href={home}>{en ? 'Back to the map' : '回到地圖'}</a>
            </div>
          </div>

          <Subscribe lang={lang} />

          {place ? (
            <div class="legs">
              {seasons.map((s) => (
                <div class="season">
                  <span class="lab">{place.series.name} · {T.season(s.n)}</span>
                  <h2>{en ? s.nameEn : s.name}</h2>
                  <div class:list={['line', { open: !!s.upcoming }]}>
                    {s.posts.map((id) => {
                      const p = byId.get(id);
                      if (!p) return null;
                      const k = epLabel(id);
                      return id === post.id ? (
                        <div class="leg cur"><span class="k">{k} · {dotDate(p.data.date)} · {T.youAreHere}</span><b class="keep">{titleIn(p, lang)}</b></div>
                      ) : (
                        <a class="leg" href={postUrl(p, lang)}><span class="k">{k} · {dotDate(p.data.date)} · {num(lengthOf(p, lang))} {T.unit}</span><b class="keep">{titleIn(p, lang)}</b></a>
                      );
                    })}
                    {s.upcoming && s.next && <div class="leg next"><span class="k">S{s.n}·{s.next.n - s.from + 1} · {T.upcoming}</span><b>{en ? s.upcomingEn : s.upcoming}</b></div>}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="legs pager">
              {older ? (
                <a class="pg" href={postUrl(older, lang)}><span class="lab">{T.prev} · {dotDate(older.data.date)}</span><b class="keep">{titleIn(older, lang)}</b></a>
              ) : <span />}
              {newer ? (
                <a class="pg nx" href={postUrl(newer, lang)}><span class="lab">{T.next} · {dotDate(newer.data.date)} →</span><b class="keep">{titleIn(newer, lang)}</b></a>
              ) : <span />}
            </div>
          )}

          {near.length > 0 && (
            <div class="nb">
              <span class="lab">{T.nearLab}</span>
              <div class="cards">
                {near.map(({ post: q, days }) => (
                  <a class="nbc" href={en ? `/en/writing/${q.es}/` : `/posts/${q.id}/`}>
                    <span class="lab"><span>{regionName(q.topic, lang)}</span><span>{days === 0 ? T.sameDay : T.apart(days)}</span></span>
                    <b class="keep">{en ? q.te : q.t}</b>
                    {(en ? q.xe : q.x) && <span class="x">{en ? q.xe : q.x}</span>}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="author">
            <img src="/assets/img/avatar-640.webp" alt={T.name} width="84" height="84" loading="lazy" />
            <div><span class="lab">{T.surveyor}</span><h2>{T.name}</h2><p>{T.bio}</p></div>
            <div class="acts">
              <a class="btn" href={en ? '/en/about/' : '/about/'}>{T.about}</a>
              {en
                ? <a class="btn" href="/en/speaking/#book">Invite me to speak</a>
                : <button class="btn" type="button" data-copy="cch.chichieh@gmail.com" data-done="已複製 cch.chichieh@gmail.com">邀請演講 · 複製 Email</button>}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <dialog class="lb" id="lb" aria-label={T.zoom}>
    <div class="in"><img id="lbImg" alt="" /></div>
    <div class="lbbar"><span id="lbCap"></span><button class="btn" type="button" id="lbClose">{T.close}</button></div>
  </dialog>
</Base>

<style>
  .prog { position: fixed; left: 0; top: 0; height: 2px; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--trail); z-index: 60; }

  .hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 72px); align-items: center; padding-block: clamp(36px, 5vw, 72px) clamp(40px, 5vw, 64px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .crumbs a:hover { color: var(--trail); }
  .crumbs i { width: 14px; height: 1px; background: var(--ink-3); display: inline-block; }
  .crumbs .here { color: var(--trail); }
  .draft { border: 1px dashed var(--ink-3); padding: 1px 6px; margin-left: 6px; }
  h1 { margin: 22px 0 0; font-weight: 300; font-size: clamp(38px, 5.2vw, 76px); line-height: 1.14; letter-spacing: .01em; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--line); }
  .meta div { display: flex; flex-direction: column; gap: 2px; }
  .meta b { font-family: var(--mono); font-stretch: 80%; font-weight: 500; font-size: 16px; color: var(--ink); letter-spacing: .02em; }
  .byrow { display: flex; align-items: center; gap: 14px; margin-top: 26px; flex-wrap: wrap; }
  .byrow img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; filter: grayscale(.2); }
  .who { display: flex; flex-direction: column; line-height: 1.4; }
  .who b { font-weight: 500; font-size: 15px; }
  .byrow .btn { margin-left: auto; }
  .tr { margin: 14px 0 0; color: var(--ink-3); }
  .tr a { color: var(--ink-2); border-bottom: 1px solid var(--line); }
  .tr a:hover { color: var(--trail); border-color: var(--trail); }

  .locator { position: relative; aspect-ratio: 1 / 1; max-width: 100%; border: 1px solid var(--line); background: var(--ground-2); }
  .locator canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ttl { position: absolute; left: 12px; top: 10px; z-index: 2; text-shadow: 0 0 6px var(--halo), 0 0 2px var(--halo); }
  .ttl b { display: block; font-family: var(--sans); font-weight: 500; font-size: 13px; letter-spacing: .2em; color: var(--ink); text-transform: none; }
  .inset { position: absolute; right: 10px; bottom: 10px; width: 34%; aspect-ratio: 1440 / 835; border: 1px solid var(--ink-3); background: var(--ground); z-index: 2; }
  .inset canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .inset span { position: absolute; left: 4px; top: -17px; font-family: var(--mono); font-stretch: 80%; font-size: 9px; letter-spacing: .14em; color: var(--ink-3); }
  .lscale { position: absolute; left: 12px; bottom: 12px; z-index: 2; display: flex; align-items: flex-end; gap: 8px; font-family: var(--mono); font-stretch: 80%; font-size: 9.5px; color: var(--ink-2); letter-spacing: .08em; }
  .lscale i { display: block; height: 6px; border: 1px solid var(--ink-2); border-top: 0; background: linear-gradient(90deg, var(--ink-2) 50%, transparent 50%); }
  .locator :global(.ring) { position: absolute; z-index: 3; width: 0; height: 0; pointer-events: none; }
  .locator :global(.ring i) { position: absolute; left: -17px; top: -17px; width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid var(--trail); }
  .locator :global(.ring i:nth-child(2)) { animation: ping 2.4s cubic-bezier(.2, .6, .3, 1) infinite; }
  @keyframes ping { from { transform: scale(.6); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
  .locator :global(.ring span) { position: absolute; left: 24px; top: -12px; white-space: nowrap; font-family: var(--mono); font-stretch: 80%; font-size: 10.5px; letter-spacing: .12em; color: var(--trail); padding: 3px 7px; border: 1px solid var(--trail); background: var(--ground); }
  .locator :global(.ring.l span) { left: auto; right: 24px; }
  .mtip { position: absolute; z-index: 5; max-width: 240px; padding: 9px 11px; background: var(--ground); border: 1px solid var(--trail); font-size: 13px; line-height: 1.55; pointer-events: none; opacity: 0; transition: opacity .12s; }
  .mtip:global(.show) { opacity: 1; }
  .mtip :global(.lab) { color: var(--trail); display: block; font-size: 10px; }

  .desk { display: grid; grid-template-columns: 208px minmax(0, 1fr); gap: 56px; border-top: 1px solid var(--line); padding-top: clamp(40px, 5vw, 72px); }
  .route { position: sticky; top: 28px; align-self: start; height: calc(100vh - 56px); display: flex; flex-direction: column; gap: 14px; }
  .route .head { display: flex; flex-direction: column; gap: 4px; }
  .route .head b { font-family: var(--mono); font-stretch: 80%; font-weight: 500; font-size: 22px; color: var(--ink); line-height: 1.1; }
  .path { position: relative; flex: 1; min-height: 200px; margin-left: 6px; }
  .path .base { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-left: 2px dashed var(--line); }
  .path .fill { position: absolute; left: -1px; top: 0; width: 2px; height: 0; background: var(--trail); }
  .path .me { position: absolute; left: -6px; width: 12px; height: 12px; border-radius: 50%; background: var(--trail); box-shadow: 0 0 0 4px var(--ground), 0 0 0 5px var(--trail); top: -6px; }
  .path :global(.wp) { position: absolute; left: -5px; display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 12px; align-items: start; width: 200px; cursor: pointer; background: none; border: 0; padding: 0; text-align: left; color: var(--ink-3); font: inherit; }
  .path :global(.wp::before) { content: ""; width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid currentColor; background: var(--ground); margin-top: 5px; }
  .path :global(.wp span) { font-size: 12.5px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .path :global(.wp em) { font-style: normal; font-family: var(--mono); font-stretch: 80%; font-size: 10px; letter-spacing: .1em; display: block; opacity: .85; }
  .path :global(.wp.done) { color: var(--ink-2); }
  .path :global(.wp.done::before) { background: var(--trail); border-color: var(--trail); }
  .path :global(.wp.on) { color: var(--ink); }
  .path :global(.wp.on::before) { background: var(--trail); border-color: var(--trail); box-shadow: 0 0 0 3px var(--trail-soft); }
  .path :global(.wp:hover) { color: var(--trail); }
  .route .foot { color: var(--ink-3); }

  .paper { position: relative; max-width: calc(660px + 56px + 236px); min-width: 0; }
  @media (min-width: 1200px) {
    :global(.js) .prose :global(aside.sn) { position: absolute; left: calc(660px + 56px); width: 236px; margin: 0; }
    .prose :global(figure.plate) { width: calc(100% + 56px + 236px); }
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 2em 0 0; max-width: 660px; }

  .end { margin-top: clamp(56px, 7vw, 96px); border-top: 1px solid var(--line); }
  .fin { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 20px 28px; align-items: center; padding-block: 36px; border-bottom: 1px solid var(--line); }
  .fin svg { display: block; }
  .fint { margin: 0; font-weight: 300; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.3; }
  .fint b { font-weight: 500; color: var(--trail); font-family: var(--mono); font-stretch: 80%; }
  .acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .legs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); padding-block: clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--line); }
  .season h2 { margin: 4px 0 18px; font-weight: 300; font-size: clamp(22px, 2vw, 28px); }
  .line { position: relative; padding-left: 28px; }
  .line::before { content: ""; position: absolute; left: 6px; top: 10px; bottom: 10px; border-left: 2px solid var(--trail); opacity: .55; }
  .line.open::before { bottom: 70px; }
  .line.open::after { content: ""; position: absolute; left: 6px; bottom: 30px; height: 46px; border-left: 2px dashed var(--trail); opacity: .55; }
  .leg { position: relative; display: block; padding: 10px 0 12px; }
  .leg::before { content: ""; position: absolute; left: -27px; top: 17px; width: 12px; height: 12px; border-radius: 50%; background: var(--ground); border: 2px solid var(--trail); }
  .leg .k { font-family: var(--mono); font-stretch: 80%; font-size: 10.5px; letter-spacing: .12em; color: var(--ink-3); }
  .leg b { display: block; font-weight: 500; font-size: 16.5px; line-height: 1.5; transition: color .15s; }
  a.leg:hover b { color: var(--trail); }
  .leg.cur::before { background: var(--trail); box-shadow: 0 0 0 4px var(--trail-soft); }
  .leg.cur .k { color: var(--trail); }
  .leg.next::before { border-style: dashed; background: transparent; }
  .leg.next b { font-weight: 300; color: var(--ink-2); }
  .pager .pg { display: flex; flex-direction: column; gap: 6px; padding-top: 14px; border-top: 1px solid var(--ink-2); }
  .pager .pg b { font-weight: 500; font-size: 17px; line-height: 1.55; }
  .pager .pg:hover b { color: var(--trail); }
  .pager .nx { text-align: right; }
  .nb { padding-block: clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--line); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); margin-top: 18px; }
  .nbc { display: flex; flex-direction: column; gap: 6px; padding-top: 14px; border-top: 1px solid var(--ink-2); }
  .nbc .lab { display: flex; justify-content: space-between; gap: 10px; color: var(--trail); }
  .nbc b { font-weight: 500; font-size: 17px; line-height: 1.55; }
  .nbc .x { font-size: 13.5px; color: var(--ink-2); line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .nbc:hover b { color: var(--trail); }
  .author { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 24px; align-items: center; padding-block: clamp(36px, 5vw, 64px) 0; }
  .author img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; filter: grayscale(.2); }
  .author h2 { margin: 0 0 4px; font-weight: 500; font-size: 20px; }
  .author p { margin: 0; color: var(--ink-2); font-size: 15px; max-width: 40em; }
  .author .acts { justify-content: flex-end; }

  .mbar { display: none; }
  dialog.lb { border: 0; padding: 0; background: transparent; max-width: min(1400px, 96vw); max-height: 94vh; width: 100%; color: var(--ink); }
  dialog.lb::backdrop { background: color-mix(in srgb, var(--ground) 92%, transparent); backdrop-filter: blur(3px); }
  .lb .in { background: var(--plate); padding: clamp(12px, 2vw, 28px); max-height: 84vh; overflow: auto; }
  .lb img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .lbbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 12px; }
  .lbbar span { font-size: 13.5px; color: var(--ink-2); }

  @media (prefers-reduced-motion: reduce) { .prog { display: none; } }
  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; }
    .locator { aspect-ratio: 4 / 3; }
    .desk { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .route { display: none; }
    .mbar { display: block; position: sticky; top: 0; z-index: 40; background: var(--ground); border-bottom: 1px solid var(--line); margin-inline: calc(var(--gut) * -1); padding: 0 var(--gut); margin-bottom: 28px; }
    .mbar button { width: 100%; display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 12px 0; background: none; border: 0; color: var(--ink); font: 500 14px/1.4 var(--sans); text-align: left; cursor: pointer; }
    .mbar button span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mbar .pct { font-family: var(--mono); font-stretch: 80%; font-size: 11px; color: var(--trail); flex: none; }
    .mbar ol { list-style: none; margin: 0; padding: 0 0 12px; }
    .mbar ol a { display: flex; gap: 12px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 14px; color: var(--ink-2); }
    .mbar ol em { font-style: normal; font-family: var(--mono); font-stretch: 80%; font-size: 10.5px; color: var(--trail); min-width: 34px; padding-top: 3px; }
    .mbar .pbar { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--trail); }
    .prog { display: none; }
    .legs, .cards { grid-template-columns: 1fr; }
    .author { grid-template-columns: auto minmax(0, 1fr); }
    .author .acts { grid-column: 1 / -1; justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .meta { gap: 10px 20px; }
    .byrow .btn { margin-left: 0; }
    .fin { grid-template-columns: auto minmax(0, 1fr); }
    .fin .acts { grid-column: 1 / -1; }
    .prose :global(h2) { word-break: normal; }
  }
</style>

<script>
  import { makeModel, type Model, type Pt } from '../lib/terrain/model';
  import { drawTerrain, drawCairn, readColors, setupCanvas, type View } from '../lib/terrain/render';
  import { REGIONS } from '../lib/regions';
  import type { PostSummary } from '../lib/posts';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  /* ── 位置圖 ── */
  const loc = $('loc'), lcv = $<HTMLCanvasElement>('lcv'), icv = $<HTMLCanvasElement>('icv'), lov = $('lov'), mtip = $('mtip');
  const ID = loc.dataset.id!;
  const EN = loc.dataset.lang === 'en';
  const S: { here: string; reading: string; start: string; done: string; left: string } = JSON.parse(loc.dataset.s!);
  const title = (p: PostSummary) => (EN ? p.te ?? p.t : p.t);
  const urlOf = (p: PostSummary) => (EN ? `/en/writing/${p.es}/` : `/posts/${p.id}/`);
  const seriesMeta: { id: string; label: string }[] = JSON.parse(loc.dataset.series || '[]');
  let M: Model | null = null, view: View, LW = 0, LH = 0, hov = -1;
  let DP: { q: Pt; x: number; y: number }[] = [];

  function drawMap() {
    if (!M) return;
    const r = loc.getBoundingClientRect();
    LW = Math.round(r.width); LH = Math.round(r.height);
    if (!LW) return;
    const ctx = setupCanvas(lcv, LW, LH);
    const col = readColors();
    const mine = M.pts.find((q) => q.p.id === ID)!;
    const series = seriesMeta.map((s) => M!.pts.find((q) => q.p.id === s.id)).filter((q): q is Pt => !!q);
    // 視窗：有連載就框住整條路線，沒有就以這篇為中心
    const focus = series.length > 1 ? series : [mine];
    const xs = focus.map((q) => q.x), ys = focus.map((q) => q.y);
    const bw = Math.max(...xs) - Math.min(...xs), bh = Math.max(...ys) - Math.min(...ys);
    const cx = (Math.min(...xs) + Math.max(...xs)) / 2 + 6, cy = (Math.min(...ys) + Math.max(...ys)) / 2 + bh * 0.35;
    const vw = Math.max(focus.length > 1 ? 170 : 240, bw * 3.4, (bh * 3.4 * LW) / LH), vh = (vw * LH) / LW;
    view = { x: cx - vw / 2, y: cy - vh / 2, w: vw, h: vh };
    drawTerrain(ctx, M, view, LW, LH, col, { grid: 3, levels: 78, majorEvery: 15, minorW: 0.6, majorW: 1.15 });
    const k = LW / view.w, X = (x: number) => (x - view.x) * k, Y = (y: number) => (y - view.y) * k;
    // 每月路線
    ctx.save(); ctx.beginPath();
    M.trail.forEach((p, i) => (i ? ctx.lineTo(X(p[0]), Y(p[1])) : ctx.moveTo(X(p[0]), Y(p[1]))));
    ctx.strokeStyle = col.ground; ctx.lineWidth = 5; ctx.globalAlpha = 0.55; ctx.stroke();
    ctx.globalAlpha = 0.65; ctx.setLineDash([5, 5]); ctx.strokeStyle = col.trail; ctx.lineWidth = 1.6; ctx.stroke(); ctx.restore();
    // 顯示位置：把擠在一起的石堆稍微推開（示意圖，不超過幾個像素）
    DP = M.pts.map((q) => ({ q, x: X(q.x), y: Y(q.y) }));
    const vis = DP.filter((d) => d.x > -30 && d.y > -30 && d.x < LW + 30 && d.y < LH + 30);
    for (let it = 0; it < 40; it++)
      for (let i = 0; i < vis.length; i++)
        for (let j = i + 1; j < vis.length; j++) {
          const A = vis[i], B = vis[j], dx = B.x - A.x, dy = B.y - A.y, d = Math.hypot(dx, dy) || 0.01;
          if (d < 30) {
            const m = (30 - d) / 2, ux = dx / d, uy = dy / d, fa = A.q === mine ? 0 : 1, fb = B.q === mine ? 0 : 1;
            A.x -= ux * m * fa * (fb ? 1 : 2); A.y -= uy * m * fa * (fb ? 1 : 2);
            B.x += ux * m * fb * (fa ? 1 : 2); B.y += uy * m * fb * (fa ? 1 : 2);
          }
        }
    const sp = series.map((q) => DP.find((d) => d.q === q)!);
    if (sp.length > 1) {
      ctx.beginPath(); sp.forEach((d, i) => (i ? ctx.lineTo(d.x, d.y - 6) : ctx.moveTo(d.x, d.y - 6)));
      ctx.strokeStyle = col.ground; ctx.lineWidth = 6; ctx.stroke(); ctx.strokeStyle = col.trail; ctx.lineWidth = 2; ctx.stroke();
    }
    for (let i = DP.length - 1; i >= 0; i--) {
      const d = DP[i];
      if (d.x < -20 || d.y < -20 || d.x > LW + 20 || d.y > LH + 20) continue;
      const strong = series.includes(d.q) || d.q === mine;
      ctx.globalAlpha = strong || i === hov ? 1 : 0.55;
      drawCairn(ctx, d.x, d.y, d.q.p.n, i === hov ? col.ink : col.trail, col.ground, strong ? 1.35 : 1.1);
    }
    ctx.globalAlpha = 1;
    // 連載的段落標籤：每個石堆試 24 個位置，挑重疊最少、最近的
    const md = DP.find((d) => d.q === mine)!;
    const ringLeft = md.x > LW - 150;
    ctx.font = '500 10.5px "Martian Mono", monospace'; ctx.textBaseline = 'middle';
    type Box = { x0: number; y0: number; x1: number; y1: number };
    const boxes: Box[] = vis.map((d) => ({ x0: d.x - 13, y0: d.y - 26, x1: d.x + 13, y1: d.y + 4 }));
    boxes.push(ringLeft ? { x0: md.x - 130, y0: md.y - 22, x1: md.x - 20, y1: md.y + 2 } : { x0: md.x + 20, y0: md.y - 22, x1: md.x + 130, y1: md.y + 2 });
    const hits = (b: Box) => boxes.reduce((n, o) => n + (!(b.x1 < o.x0 || b.x0 > o.x1 || b.y1 < o.y0 || b.y0 > o.y1) ? 1 : 0), 0) + (b.x0 < 4 || b.y0 < 36 || b.x1 > LW - 4 || b.y1 > LH - 4 ? 5 : 0);
    sp.forEach((d) => {
      if (d.q === mine) return;
      const t = seriesMeta.find((s) => s.id === d.q.p.id)!.label, w = ctx.measureText(t).width;
      let best: [number, number, number, Box] | null = null, bs = 1e9;
      for (const rr of [16, 30, 46])
        for (const a of [0, 180, -90, 90, -45, -135, 45, 135]) {
          const rad = (a * Math.PI) / 180, c = Math.cos(rad);
          const ox = c * rr - (c < -0.1 ? w : Math.abs(c) < 0.1 ? w / 2 : 0), oy = Math.sin(rad) * rr - 12 + (a === 90 ? 24 : 0);
          const bx = { x0: d.x + ox - 3, y0: d.y + oy - 8, x1: d.x + ox + w + 3, y1: d.y + oy + 8 };
          const sc = hits(bx) * 100 + rr;
          if (sc < bs) { bs = sc; best = [ox, oy, rr, bx]; }
        }
      if (!best) return;
      boxes.push(best[3]);
      if (best[2] > 16) { ctx.beginPath(); ctx.moveTo(d.x, d.y - 10); ctx.lineTo(d.x + best[0] + (best[0] < 0 ? w : 0), d.y + best[1]); ctx.strokeStyle = col.ink3; ctx.lineWidth = 1; ctx.stroke(); }
      ctx.lineWidth = 4; ctx.strokeStyle = col.ground; ctx.strokeText(t, d.x + best[0], d.y + best[1]);
      ctx.fillStyle = col.ink2; ctx.fillText(t, d.x + best[0], d.y + best[1]);
    });
    // 視窗內的地名
    ctx.font = EN ? '500 12.5px "Hanken Grotesk", sans-serif' : '500 12px "Noto Sans TC", sans-serif'; ctx.textBaseline = 'alphabetic';
    REGIONS.forEach((r, ki) => {
      const xs2 = DP.filter((d) => d.q.k === ki && d.x > 0 && d.x < LW && d.y > 0 && d.y < LH).map((d) => d.x);
      if (!xs2.length) return;
      const yy = Y(M!.at(0.5, (ki + 0.5) / REGIONS.length)[1]);
      if (yy < 40 || yy > LH - 30) return;
      const xx = Math.max(16, Math.min(LW - 120, Math.min(...xs2) - 80));
      const t = EN ? r.name : r.key + r.suffix;
      ctx.lineWidth = 4; ctx.strokeStyle = col.ground; ctx.strokeText(t, xx, yy + 26); ctx.fillStyle = col.ink3; ctx.fillText(t, xx, yy + 26);
    });
    const lab = seriesMeta.find((s) => s.id === ID)?.label;
    lov.innerHTML = `<div class="ring${ringLeft ? ' l' : ''}" style="left:${md.x}px;top:${md.y - 7}px"><i></i><i></i><span>${S.here}${lab ? ' · ' + lab : ''}</span></div>`;
    $('lsc').style.width = Math.round(((M.span * (14 * 864e5)) / (M.T1 - M.T0)) * k) + 'px';
    // 全圖小地圖
    const ir = icv.getBoundingClientRect(), IW = Math.round(ir.width), IH = Math.round(ir.height);
    const ic = setupCanvas(icv, IW, IH);
    drawTerrain(ic, M, { x: 0, y: 0, w: M.VW, h: M.VH }, IW, IH, col, { grid: 2, levels: 13, majorEvery: 99, minorW: 0.5 });
    const ik = IW / M.VW;
    ic.beginPath(); M.trail.forEach((p, i) => (i ? ic.lineTo(p[0] * ik, p[1] * ik) : ic.moveTo(p[0] * ik, p[1] * ik)));
    ic.strokeStyle = col.trail; ic.lineWidth = 1; ic.stroke();
    ic.strokeStyle = col.ink; ic.lineWidth = 1.2; ic.strokeRect(view.x * ik, view.y * ik, view.w * ik, view.h * ik);
  }

  loc.addEventListener('pointermove', (e) => {
    if (!M) return;
    const r = loc.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top;
    let best = -1, bd = 400;
    DP.forEach((p, i) => { const dx = p.x - mx, dy = p.y - 6 - my, d = dx * dx + dy * dy; if (d < bd) { bd = d; best = i; } });
    if (best !== hov) { hov = best; drawMap(); }
    if (best >= 0) {
      const q = DP[best].q, lab = seriesMeta.find((s) => s.id === q.p.id)?.label;
      mtip.innerHTML = `<span class="lab">${lab ? lab + ' · ' : ''}${q.p.d.replaceAll('-', '.')}</span>${esc(title(q.p))}`;
      let x = DP[best].x + 14, y = DP[best].y - 50;
      if (x + 240 > LW) x = DP[best].x - 254;
      if (y < 8) y = 8;
      mtip.style.left = x + 'px'; mtip.style.top = y + 'px'; mtip.classList.add('show');
      loc.style.cursor = q.p.id === ID ? 'default' : 'pointer';
    } else { mtip.classList.remove('show'); loc.style.cursor = 'default'; }
  });
  loc.addEventListener('pointerleave', () => { hov = -1; mtip.classList.remove('show'); drawMap(); });
  loc.addEventListener('click', () => { if (hov >= 0 && DP[hov].q.p.id !== ID) location.href = urlOf(DP[hov].q.p); });

  /* ── 閱讀路線 ── */
  const prose = $('prose'), path = $('path'), fill = $('fill'), meDot = $('me');
  const h2s = [...prose.querySelectorAll<HTMLElement>(':scope > h2')];
  const heads = h2s.length >= 2 ? h2s : [...prose.querySelectorAll<HTMLElement>(':scope > h3')];
  const label = (h: HTMLElement) => h.querySelector('.hn')?.textContent ?? '';
  const textOfH = (h: HTMLElement) => (h.querySelector('.ht') ?? h).textContent ?? '';
  const wps = heads.map((h) => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'wp';
    b.innerHTML = `<span><em>${esc(label(h))}</em>${esc(textOfH(h))}</span>`;
    b.onclick = () => h.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    path.appendChild(b);
    return b;
  });
  let ph = 0;
  // 路標依段落在文中的位置排列；用每個路標的實際高度避免重疊（英文標題常常比較長）
  function layoutRoute() {
    ph = path.clientHeight;
    const total = prose.offsetHeight, gap = 10;
    const hs = wps.map((w) => w.offsetHeight || 36);
    const ys = heads.map((h) => (h.offsetTop / total) * ph);
    for (let i = 1; i < ys.length; i++) ys[i] = Math.max(ys[i], ys[i - 1] + hs[i - 1] + gap);
    for (let i = ys.length - 1; i >= 0; i--) ys[i] = Math.min(ys[i], i === ys.length - 1 ? ph - hs[i] : ys[i + 1] - hs[i] - gap);
    ys.forEach((y, i) => (wps[i].style.top = Math.max(0, y) - 6 + 'px'));
  }
  // 引用註記移到右側邊欄，避開跨進邊欄的圖版
  function placeNotes() {
    const wide = innerWidth >= 1200;
    const plates = [...prose.querySelectorAll<HTMLElement>('figure.plate')].map((f) => ({ t: f.offsetTop - 12, b: f.offsetTop + f.offsetHeight + 12 }));
    let floor = 0;
    prose.querySelectorAll<HTMLElement>('aside.sn').forEach((n) => {
      if (!wide) { n.style.top = ''; return; }
      const prev = n.previousElementSibling as HTMLElement | null, h = n.offsetHeight;
      let y = Math.max(prev ? prev.offsetTop : 0, floor);
      for (const p of plates) if (y < p.b && y + h > p.t) { const up = p.t - h - 6; y = up >= floor && up >= y - 160 ? up : p.b + 6; }
      n.style.top = y + 'px';
      floor = y + h + 18;
    });
  }
  const prog = $('prog'), pct = $('pct'), left = $('left'), mpct = $('mpct'), mpbar = $('mpbar'), mcur = $('mcur');
  const MINS = +(left.dataset.mins || 1);
  function onScroll() {
    const r = prose.getBoundingClientRect(), vh = innerHeight;
    const p = Math.min(1, Math.max(0, (vh * 0.35 - r.top) / Math.max(1, r.height - vh * 0.35)));
    prog.style.transform = `scaleX(${p})`; mpbar.style.transform = `scaleX(${p})`;
    const pc = Math.round(p * 100);
    pct.textContent = pc + '%'; mpct.textContent = pc + '%';
    left.textContent = p >= 0.99 ? S.done : S.left.replace('{n}', String(Math.max(1, Math.round(MINS * (1 - p)))));
    fill.style.height = p * ph + 'px'; meDot.style.top = p * ph - 6 + 'px';
    let cur = -1;
    heads.forEach((h, i) => { if (h.getBoundingClientRect().top < vh * 0.4) cur = i; });
    wps.forEach((w, i) => { w.classList.toggle('done', i < cur); w.classList.toggle('on', i === cur); });
    mcur.textContent = cur < 0 ? (p > 0.02 ? S.reading : S.start) : `${label(heads[cur])}　${textOfH(heads[cur])}`.trim();
  }
  addEventListener('scroll', onScroll, { passive: true });

  const mbtn = $('mbtn'), mlist = document.getElementById('mlist');
  if (mlist) {
    mbtn.onclick = () => { const open = mlist.hidden; mlist.hidden = !open; mbtn.setAttribute('aria-expanded', String(open)); };
    mlist.onclick = (e) => { if ((e.target as HTMLElement).closest('a')) { mlist.hidden = true; mbtn.setAttribute('aria-expanded', 'false'); } };
  }

  /* 點 [n]：寬螢幕閃一下旁邊的註記 */
  prose.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('sup.ref a');
    if (!a) return;
    const n = document.querySelector<HTMLElement>(a.getAttribute('href')!);
    if (n && innerWidth >= 1200) { e.preventDefault(); n.classList.remove('flash'); void n.offsetWidth; n.classList.add('flash'); }
  });

  /* 圖片放大 */
  const lb = $<HTMLDialogElement>('lb'), lbImg = $<HTMLImageElement>('lbImg'), lbCap = $('lbCap');
  prose.querySelectorAll<HTMLButtonElement>('figure.plate .zoom').forEach((b) => {
    b.onclick = () => {
      const img = b.querySelector('img')!, fc = b.parentElement!.querySelector('figcaption');
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt;
      lbCap.textContent = fc ? `${fc.querySelector('.fn')?.textContent ?? ''}　${fc.querySelector('.ct')?.textContent?.trim() ?? ''}` : img.alt;
      lb.showModal();
    };
  });
  $('lbClose').onclick = () => lb.close();
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

  /* 複製 */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label0 = b.textContent;
    b.onclick = async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = b.dataset.done!; }
      catch { b.textContent = b.dataset.copy!; }
      setTimeout(() => (b.textContent = label0), 2200);
    };
  });

  /* 開機 */
  function relayout() { drawMap(); layoutRoute(); placeNotes(); onScroll(); }
  let rt: number;
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(relayout, 120); });
  addEventListener('themechange', drawMap);
  prose.querySelectorAll('img').forEach((i) => i.addEventListener('load', () => { layoutRoute(); placeNotes(); }));
  relayout();
  document.fonts?.ready.then(relayout);
  fetch('/map-data.json').then((r) => r.json()).then((data: PostSummary[]) => { M = makeModel(EN ? data.filter((p) => p.es) : data, 'h'); drawMap(); }).catch(() => {});
</script>
